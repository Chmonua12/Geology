POLZA_API_KEY=your_polza_api_key_here
# Необязательно локально. На Render задаётся как секрет для защиты /mcp.
MCP_AUTH_TOKEN=replace_with_a_long_random_value
# Необязательно: путь к SQLite на постоянном диске Render.
SQLITE_PATH=/var/data/db.sqlite3
# Публичный адрес Django-сайта используется при создании игровых маршрутов.
GEOLOGY_APP_URL=http://127.0.0.1:8000/
# Разрешённые браузерные источники для Bun API.
ALLOWED_ORIGINS=http://127.0.0.1:8000,http://127.0.0.1:5173
