{
  "name": "geology-adaptive-expedition",
  "private": true,
  "packageManager": "bun@1.4.4",
  "workspaces": [
    "frontend",
    "mcp-server"
  ],
  "scripts": {
    "dev": "bun run scripts/dev.ts",
    "dev:django": "python manage.py runserver 127.0.0.1:8000",
    "dev:api": "bun run --cwd mcp-server dev",
    "dev:frontend": "bun run --cwd frontend dev",
    "mcp": "bun run --cwd mcp-server mcp",
    "build": "bun run --cwd frontend build",
    "test": "bun test mcp-server/src",
    "check": "bun run test && bun run build"
  }
}
